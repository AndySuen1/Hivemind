{
  "name": "@hivemind/launcher",
  "version": "0.0.1",
  "private": true,
  "description": "Hivemind 托盘启动器（Electron 壳；orchestrator/dashboard 以独立 Node 子进程 spawn，原生模块零重编译）",
  "main": "dist-electron/main.js",
  "scripts": {
    "gen-icons": "node scripts/gen-icons.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "pack": "electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^31.7.7",
    "typescript": "^5.6.3"
  }
}
