# Phase 0 单 bot MVP 配置（复制为 apps/orchestrator/.env 后填值）

# Discord Bot Token：Discord Developer Portal → Applications → 你的 App → Bot → Reset Token
DISCORD_BOT_TOKEN=

# DeepSeek API Key：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 你的 Discord User ID 白名单（开发者模式 → 右键自己头像 → 复制 user ID）
# 多个用逗号分隔，留空 = 不限制（仅测试期）
ALLOWED_USER_IDS=

# bot 人格（中文）
SYSTEM_PROMPT=你是一个友好、简洁的中文助手。
